<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- `dotnet publish` lands in <repo>/publish/ by default. CI passes -o publish too,
         which sets the same value. Override locally with -o <dir> or -p:PublishDir=<dir>. -->
    <PublishDir>$(MSBuildThisFileDirectory)..\publish\</PublishDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="27.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="2.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\Sma5h\Mods\Sma5h.Mods.Music\Sma5h.Mods.Music.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VGAudioCli">
      <HintPath>..\Tools\VGAudioCli.exe</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    Publish-time copy of Tools/ and Resources/ into the output directory so
    `dotnet publish` produces a self-contained, runnable folder.
    `CopyToOutputDirectory="Never"` keeps the dev `bin/` lean — at dev time
    Program.cs walks up from AppContext.BaseDirectory to find Resources/ at
    the repo root, so we don't need these copied for local runs.

    Excludes:
      - Resources/Game/** is user-extracted vanilla Nintendo data. Never
        redistribute it. The folder ships in releases containing only the
        README.txt explaining what the user needs to put there.
      - *.nus3audio / *.nus3bank also caught globally as a safety net for
        anything outside Resources/Game/ (e.g. template.nus3bank at Resources/).
  -->
  <ItemGroup>
    <Content Include="..\Tools\**\*"
             Exclude="..\Tools\**\*.nus3audio;..\Tools\**\*.nus3bank"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="PreserveNewest"
             Link="Tools\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\Resources\**\*"
             Exclude="..\Resources\Game\**\*;..\Resources\**\*.nus3audio;..\Resources\**\*.nus3bank"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="PreserveNewest"
             Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\Resources\Game\README.txt"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="PreserveNewest"
             Link="Resources\Game\README.txt" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Program.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <!--
    VGAudioCli.exe is a <Reference> (compile-time) AND matched by the Tools/** Content
    glob above. MSBuild dedupes the two and a single-file publish bundles neither on
    disk, so publish/Tools/VGAudioCli.exe goes missing and audio conversion fails at
    runtime (Program.cs resolves it from Tools/ at load time — this puts it there).
  -->
  <Target Name="CopyVGAudioCliToPublishTools" AfterTargets="Publish">
    <Copy SourceFiles="..\Tools\VGAudioCli.exe"
          DestinationFolder="$(PublishDir)Tools"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
